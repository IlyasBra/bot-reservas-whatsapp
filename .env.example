# Copia este archivo a .env y rellena los valores. NUNCA subas el archivo .env a GitHub.

# Token que tú inventas y que debes escribir también en la configuración del webhook de Meta
VERIFY_TOKEN=pon-aqui-un-texto-secreto-cualquiera

# Secreto de la app (Meta for Developers > Configuración de la app > Básica). Activa la comprobación de firma.
APP_SECRET=

# Credenciales de la WhatsApp Cloud API (WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Opcionales
# WHATSAPP_API_VERSION=v23.0
# PORT=3000
